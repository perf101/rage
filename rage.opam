# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "RAGE, Results And Graphing Engine"
license: "BSD3"
homepage: "https://github.com/perf101/rage"
bug-reports: "https://github.com/perf101/rage/issues"
depends: [
  "dune" {>= "2.0"}
  "core" {>= "v0.13" & < "v0.15"}
  "async" {>= "v0.13" & < "v0.15"}
  "postgresql" {>= "4.5.2"}
  "ocurl" {>= "0.9.0" & < "1.0"}
  "ezjsonm"
  "owl" {>= "1.1"}
  "owl-base" {>= "1.1"}
  "ssl" {>= "0.5.7"}
  "ppx_sexp_conv"
  "ppx_let"
  "re"
  "cryptokit" {with-dev-setup & >= "1.19"}
  "mirage-crypto-rng" {with-dev-setup & >= "0.11.3"}
  "stdlib-random" {with-dev-setup & >= "1.1.0"}
  "testu01" {with-test & >= "1.2.3-0.2"}
  "cpu"
  "uri"
]
build: [
  ["dune" "subst"] {pinned}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/perf101/rage.git"
